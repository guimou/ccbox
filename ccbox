#!/bin/bash
# Claude Code Development Container Launch Script
# Launches a containerized Claude Code environment with the current directory mounted
#
# Harness-specific wrapper around lib/box-common.sh: defines the Claude Code
# image, mounts, env passthrough, and Claude-only flags (teams, tmux, safe
# mode, opt-in credentials mount).

set -e

# Resolve the real script location (follows symlinks, e.g. ~/.local/bin/ccbox)
WRAPPER_SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$WRAPPER_SOURCE" ]]; do
    WRAPPER_DIR="$(cd -P "$(dirname "$WRAPPER_SOURCE")" && pwd)"
    WRAPPER_SOURCE="$(readlink "$WRAPPER_SOURCE")"
    [[ "$WRAPPER_SOURCE" != /* ]] && WRAPPER_SOURCE="${WRAPPER_DIR}/${WRAPPER_SOURCE}"
done
SCRIPT_DIR="$(cd -P "$(dirname "$WRAPPER_SOURCE")" && pwd)"
WRAPPER_PATH="${SCRIPT_DIR}/$(basename "$WRAPPER_SOURCE")"

# Harness identity
BOX_NAME="ccbox"
HARNESS="claude"
HARNESS_TITLE="Claude Code"
HARNESS_CLI="claude"
REGISTRY_IMAGE="guimou/ccbox"
VERSION_FLAG="--claude-version"
VERSION_FILE="CLAUDE_VERSION"

# Env vars forwarded from the host
ENV_PASSTHROUGH_REGEX='^(ANTHROPIC_|CLAUDE_CODE_|CLAUDE_AX_|CLAUDE_ENABLE_|CLAUDE_AUTOCOMPACT_)'
ENV_PASSTHROUGH_VARS=(
    DISABLE_AUTOUPDATER DISABLE_AUTO_COMPACT MAX_THINKING_TOKENS
    MCP_TIMEOUT MCP_TOOL_TIMEOUT MAX_MCP_OUTPUT_TOKENS
    API_TIMEOUT_MS API_FORCE_IDLE_TIMEOUT BASH_DEFAULT_TIMEOUT_MS
    BASH_MAX_TIMEOUT_MS BASH_MAX_OUTPUT_LENGTH
    ENABLE_TOOL_SEARCH NODE_OPTIONS
    NO_COLOR FORCE_COLOR
    AWS_REGION AWS_PROFILE AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
    AWS_SESSION_TOKEN AWS_BEARER_TOKEN_BEDROCK
    OTEL_METRICS_EXPORTER OTEL_LOG_ASSISTANT_RESPONSES
    OTEL_LOG_USER_PROMPTS OTEL_LOG_TOOL_DETAILS
    OTEL_RESOURCE_ATTRIBUTES
)

# Claude-only flags
WITH_TEAMS=false
WITH_TMUX=false
SAFE_MODE=false
WITH_CREDENTIALS=false

harness_parse_arg() {
    case $1 in
        --with-teams)
            WITH_TEAMS=true
            ARG_SHIFT=1
            ;;
        --with-tmux)
            WITH_TMUX=true
            ARG_SHIFT=1
            ;;
        --safe-mode)
            SAFE_MODE=true
            ARG_SHIFT=1
            ;;
        --with-credentials)
            WITH_CREDENTIALS=true
            ARG_SHIFT=1
            ;;
        *)
            return 1
            ;;
    esac
}

harness_extra_help() {
    echo "  --with-teams             Enable agent teams (experimental)"
    echo "  --with-tmux              Run claude inside tmux (for split-pane agent teams)"
    echo "  --safe-mode              Start with all customizations disabled"
    echo "  --with-credentials       Mount ~/.claude/.credentials.json read-write (API key or OAuth)"
}

# Ensure global config files and directories exist
harness_ensure_config() {
    CLAUDE_CONFIG_DIR="${HOME}/.claude"
    local config_dir="$CLAUDE_CONFIG_DIR"

    if [[ ! -d "$config_dir" ]]; then
        log_info "Creating Claude config directory: $config_dir"
        mkdir -p "$config_dir"
    fi

    # Settings (credentials are opt-in via --with-credentials and not created here)
    [[ -f "${config_dir}/settings.json" ]] || echo '{}' > "${config_dir}/settings.json"
    [[ -f "${config_dir}/settings.local.json" ]] || echo '{}' > "${config_dir}/settings.local.json"
    if $WITH_CREDENTIALS; then
        if [[ ! -f "${config_dir}/.credentials.json" ]]; then
            log_info "No existing credentials found, starting fresh: ${config_dir}/.credentials.json"
            echo '{}' > "${config_dir}/.credentials.json"
        fi
    fi
    [[ -f "${config_dir}/keybindings.json" ]] || echo '{"bindings":[]}' > "${config_dir}/keybindings.json"
    # Global memory file (empty is fine)
    [[ -f "${config_dir}/CLAUDE.md" ]] || touch "${config_dir}/CLAUDE.md"
    # Directories
    for dir in statsig hooks commands skills agents rules themes \
               file-history paste-cache cache backups workflows; do
        [[ -d "${config_dir}/${dir}" ]] || mkdir -p "${config_dir}/${dir}"
    done
    [[ -f "${config_dir}/stats-cache.json" ]] || echo '{}' > "${config_dir}/stats-cache.json"
}

# Setup project-specific directories under ~/.claude/ccbox-projects/
harness_setup_project() {
    PROJECT_DATA_DIR="${CLAUDE_CONFIG_DIR}/ccbox-projects/${PROJECT_KEY}"

    mkdir -p "${PROJECT_DATA_DIR}/projects" \
             "${PROJECT_DATA_DIR}/todos" \
             "${PROJECT_DATA_DIR}/plans" \
             "${PROJECT_DATA_DIR}/tasks" \
             "${PROJECT_DATA_DIR}/teams" \
             "${PROJECT_DATA_DIR}/plugins" \
             "${PROJECT_DATA_DIR}/shell-snapshots" \
             "${PROJECT_DATA_DIR}/session-env" \
             "${PROJECT_DATA_DIR}/logs" \
             "${PROJECT_DATA_DIR}/debug"
    touch "${PROJECT_DATA_DIR}/history.jsonl"

    # Show first-run message for new project directories
    if [[ ! -f "${PROJECT_DATA_DIR}/.migrated" && -f "${CLAUDE_CONFIG_DIR}/history.jsonl" ]]; then
        log_info "First run with project isolation for this workspace."
        if [[ -f "${CLAUDE_CONFIG_DIR}/.credentials.json" ]]; then
            if $WITH_CREDENTIALS; then
                log_info "Credentials will be shared across all projects."
            else
                log_info "Credentials are not shared by default; use --with-credentials to mount ~/.claude/.credentials.json."
            fi
        fi
        touch "${PROJECT_DATA_DIR}/.migrated"
        log_info "Project-specific data stored in: ${PROJECT_DATA_DIR}"
    fi
}

harness_mounts() {
    # Global settings (shared across all projects)
    add_mount "${CLAUDE_CONFIG_DIR}/settings.json"       /home/coder/.claude/settings.json
    add_mount "${CLAUDE_CONFIG_DIR}/settings.local.json" /home/coder/.claude/settings.local.json
    add_mount "${CLAUDE_CONFIG_DIR}/keybindings.json"    /home/coder/.claude/keybindings.json
    add_mount "${CLAUDE_CONFIG_DIR}/CLAUDE.md"           /home/coder/.claude/CLAUDE.md
    add_mount "${CLAUDE_CONFIG_DIR}/statsig"             /home/coder/.claude/statsig
    add_mount "${CLAUDE_CONFIG_DIR}/hooks"               /home/coder/.claude/hooks
    add_mount "${CLAUDE_CONFIG_DIR}/commands"            /home/coder/.claude/commands
    add_mount "${CLAUDE_CONFIG_DIR}/skills"              /home/coder/.claude/skills
    add_mount "${CLAUDE_CONFIG_DIR}/agents"              /home/coder/.claude/agents
    add_mount "${CLAUDE_CONFIG_DIR}/rules"               /home/coder/.claude/rules
    add_mount "${CLAUDE_CONFIG_DIR}/themes"              /home/coder/.claude/themes
    # Additional global directories for core features
    add_mount "${CLAUDE_CONFIG_DIR}/file-history"        /home/coder/.claude/file-history
    add_mount "${CLAUDE_CONFIG_DIR}/paste-cache"         /home/coder/.claude/paste-cache
    add_mount "${CLAUDE_CONFIG_DIR}/cache"               /home/coder/.claude/cache
    add_mount "${CLAUDE_CONFIG_DIR}/backups"             /home/coder/.claude/backups
    add_mount "${CLAUDE_CONFIG_DIR}/stats-cache.json"    /home/coder/.claude/stats-cache.json
    add_mount "${CLAUDE_CONFIG_DIR}/workflows"           /home/coder/.claude/workflows
    # Note: ~/.claude/daemon is intentionally NOT mounted. The daemon lock file
    # stores a PID, which is meaningless across PID namespaces (host vs container,
    # or container vs container). Each container uses its own ephemeral copy
    # pre-created in the image, so daemons never clobber each other.
    # Project-specific data (isolated per project)
    add_mount "${PROJECT_DATA_DIR}/history.jsonl"        /home/coder/.claude/history.jsonl
    add_mount "${PROJECT_DATA_DIR}/projects"             /home/coder/.claude/projects
    add_mount "${PROJECT_DATA_DIR}/todos"                /home/coder/.claude/todos
    add_mount "${PROJECT_DATA_DIR}/plans"                /home/coder/.claude/plans
    add_mount "${PROJECT_DATA_DIR}/tasks"                /home/coder/.claude/tasks
    add_mount "${PROJECT_DATA_DIR}/teams"                /home/coder/.claude/teams
    add_mount "${PROJECT_DATA_DIR}/plugins"              /home/coder/.claude/plugins
    # Additional project-scoped directories for shell/session features
    add_mount "${PROJECT_DATA_DIR}/shell-snapshots"      /home/coder/.claude/shell-snapshots
    add_mount "${PROJECT_DATA_DIR}/session-env"          /home/coder/.claude/session-env
    add_mount "${PROJECT_DATA_DIR}/logs"                 /home/coder/.claude/logs
    add_mount "${PROJECT_DATA_DIR}/debug"                /home/coder/.claude/debug
    # Other config files
    add_mount "${HOME}/.claude.json"                     /home/coder/.claude.json

    # Add status line script if it exists
    if [[ -f "${CLAUDE_CONFIG_DIR}/status-line.sh" ]]; then
        add_mount "${CLAUDE_CONFIG_DIR}/status-line.sh" /home/coder/.claude/status-line.sh ro
    fi

    # Add user's global RULES.md file if it exists (read-only)
    if [[ -f "${CLAUDE_CONFIG_DIR}/RULES.md" ]]; then
        add_mount "${CLAUDE_CONFIG_DIR}/RULES.md" /home/coder/.claude/RULES.md ro
    fi

    # Enterprise managed settings (read-only)
    if [[ -d /etc/claude-code ]]; then
        add_mount /etc/claude-code /etc/claude-code ro
    fi

    # Anthropic credentials (opt-in via --with-credentials, read-write).
    # harness_ensure_config already created an empty file when missing, so it
    # always exists here (force_mount) and no "file missing" branch is needed.
    # no_status: harness_log_status prints the "Credentials:" line itself, in
    # its original position (before the GitHub summary block).
    add_optional_mount WITH_CREDENTIALS "${CLAUDE_CONFIG_DIR}/.credentials.json" "/home/coder/.claude/.credentials.json" "" force_mount "Credentials" " (shared across projects)" no_status
}

harness_pre_run() {
    # Agent teams (experimental feature)
    if $WITH_TEAMS; then
        add_env CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS 1
    fi

    # Safe mode: disable all customizations (CLAUDE.md, plugins, skills, hooks, MCP servers)
    if $SAFE_MODE; then
        EXTRA_ARGS+=(--safe-mode)
    fi

    # Wrap claude in tmux if --with-tmux is set.
    # Claude must be the direct process in the tmux pane (not wrapped in bash)
    # so that Ctrl+C (SIGINT) reaches it properly.
    LAUNCH_CMD="claude ${EXTRA_ARGS[*]}"
    if $WITH_TMUX; then
        # Start tmux detached, launch a background monitor to auto-close orphaned
        # teammate panes, then attach. The monitor polls every 3s and kills non-lead
        # panes that have dropped back to a bash prompt after claude exits.
        LAUNCH_CMD="tmux new-session -d -s coder '${LAUNCH_CMD}' && (/home/coder/.ccbox-tmux-monitor.sh &>/dev/null &) && exec tmux attach -t coder"
        NEEDS_SHELL=true
        add_env TERM xterm-256color
    fi
}

harness_log_status() {
    log_info "Agent teams: $(if $WITH_TEAMS; then echo 'enabled'; else echo 'disabled'; fi)"
    log_info "Tmux: $(if $WITH_TMUX; then echo 'enabled'; else echo 'disabled'; fi)"
    log_info "Safe mode: $(if $SAFE_MODE; then echo 'enabled'; else echo 'disabled'; fi)"
    log_info "Credentials: $(if $WITH_CREDENTIALS; then echo 'mounted (shared across projects)'; else echo 'not mounted (use --with-credentials)'; fi)"
}

# Load the shared engine and run. Two supported layouts:
#   - repo clone:     lib/box-common.sh next to the launcher
#   - flat install:   box-common.sh next to the launcher (e.g. ~/.local/bin)
if [[ -f "${SCRIPT_DIR}/lib/box-common.sh" ]]; then
    # shellcheck source=lib/box-common.sh
    source "${SCRIPT_DIR}/lib/box-common.sh"
elif [[ -f "${SCRIPT_DIR}/box-common.sh" ]]; then
    # shellcheck source=lib/box-common.sh
    source "${SCRIPT_DIR}/box-common.sh"
else
    echo "[ERROR] Shared engine box-common.sh not found in ${SCRIPT_DIR}" >&2
    echo "Download it next to the launcher:" >&2
    echo "  curl -fsSL https://raw.githubusercontent.com/guimou/ccbox/main/lib/box-common.sh -o ${SCRIPT_DIR}/box-common.sh" >&2
    exit 1
fi
box_main "$@"
