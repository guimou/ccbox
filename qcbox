#!/bin/bash
# Qwen Code Development Container Launch Script
# Launches a containerized Qwen Code environment with the current directory mounted
#
# Harness-specific wrapper around lib/box-common.sh.
#
# Qwen Code state layout (everything under ~/.qwen):
#   ~/.qwen/settings.json        user settings (shared)
#   ~/.qwen/oauth_creds.json     Qwen OAuth credentials (shared, opt-in)
#   ~/.qwen/QWEN.md              global memory file (shared)
#   ~/.qwen/projects/<key>/      per-project chat transcripts (session resume)
#   ~/.qwen/tmp/<hash>/          per-project shell history, checkpoints
#   ~/.qwen/file-history/        file backups
#
# Because every project is mounted at /workspace inside the container, Qwen's
# internal project key is identical for all projects; projects/, tmp/ and
# file-history/ are therefore isolated per project on the host
# (~/.qwen/qcbox-projects/) while settings and global memory are shared.
# Mounting projects/ is what makes `qwen --resume` work across containers.
# oauth_creds.json (credentials) is only shared when launched with
# --with-credentials (opt-in), mirroring ccbox.

set -e

# Resolve the real script location (follows symlinks, e.g. ~/.local/bin/qcbox)
WRAPPER_SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$WRAPPER_SOURCE" ]]; do
    WRAPPER_DIR="$(cd -P "$(dirname "$WRAPPER_SOURCE")" && pwd)"
    WRAPPER_SOURCE="$(readlink "$WRAPPER_SOURCE")"
    [[ "$WRAPPER_SOURCE" != /* ]] && WRAPPER_SOURCE="${WRAPPER_DIR}/${WRAPPER_SOURCE}"
done
SCRIPT_DIR="$(cd -P "$(dirname "$WRAPPER_SOURCE")" && pwd)"
WRAPPER_PATH="${SCRIPT_DIR}/$(basename "$WRAPPER_SOURCE")"

# Harness identity
BOX_NAME="qcbox"
HARNESS="qwencode"
HARNESS_TITLE="Qwen Code"
HARNESS_CLI="qwen"
REGISTRY_IMAGE="guimou/qcbox"
VERSION_FLAG="--qwen-version"
VERSION_FILE="QWENCODE_VERSION"

# Harness-specific flags
WITH_CREDENTIALS=false

# Env vars forwarded from the host (Qwen config + OpenAI-compatible provider keys)
ENV_PASSTHROUGH_REGEX='^(QWEN_|OPENAI_|DASHSCOPE_|BAILIAN_|MODELSCOPE_|OPENROUTER_|ANTHROPIC_|GEMINI_|GOOGLE_)'
ENV_PASSTHROUGH_VARS=(
    NODE_OPTIONS NO_COLOR FORCE_COLOR NODE_EXTRA_CA_CERTS
)

harness_parse_arg() {
    case $1 in
        --with-credentials)
            WITH_CREDENTIALS=true
            ARG_SHIFT=1
            ;;
        *)
            return 1
            ;;
    esac
}

harness_extra_help() {
    echo "  --with-credentials       Mount ~/.qwen/oauth_creds.json read-write (Qwen OAuth credentials)"
}

# Ensure global config files and directories exist
harness_ensure_config() {
    QWEN_CONFIG_DIR="${HOME}/.qwen"

    mkdir -p "$QWEN_CONFIG_DIR"

    [[ -f "${QWEN_CONFIG_DIR}/settings.json" ]] || echo '{}' > "${QWEN_CONFIG_DIR}/settings.json"
    # Credentials store, shared across all projects (written by the /auth flow).
    # Opt-in via --with-credentials; the image ships an empty one so Qwen Code
    # always finds oauth_creds.json inside the container.
    if $WITH_CREDENTIALS; then
        if [[ ! -f "${QWEN_CONFIG_DIR}/oauth_creds.json" ]]; then
            log_info "No existing credentials found, starting fresh: ${QWEN_CONFIG_DIR}/oauth_creds.json"
            echo '{}' > "${QWEN_CONFIG_DIR}/oauth_creds.json"
        fi
    fi
    # Global memory file (empty is fine)
    [[ -f "${QWEN_CONFIG_DIR}/QWEN.md" ]] || touch "${QWEN_CONFIG_DIR}/QWEN.md"
}

# Setup project-specific data dirs under ~/.qwen/qcbox-projects/
harness_setup_project() {
    PROJECT_DATA_DIR="${QWEN_CONFIG_DIR}/qcbox-projects/${PROJECT_KEY}"
    mkdir -p "${PROJECT_DATA_DIR}/projects" "${PROJECT_DATA_DIR}/tmp" "${PROJECT_DATA_DIR}/file-history"
}

harness_mounts() {
    PODMAN_ARGS+=(
        # Global settings and memory (shared across all projects)
        -v "${QWEN_CONFIG_DIR}/settings.json:/home/coder/.qwen/settings.json$(vol_flag "")"
        -v "${QWEN_CONFIG_DIR}/QWEN.md:/home/coder/.qwen/QWEN.md$(vol_flag "")"
        # Project-specific state (isolated per project)
        -v "${PROJECT_DATA_DIR}/projects:/home/coder/.qwen/projects$(vol_flag "")"
        -v "${PROJECT_DATA_DIR}/tmp:/home/coder/.qwen/tmp$(vol_flag "")"
        -v "${PROJECT_DATA_DIR}/file-history:/home/coder/.qwen/file-history$(vol_flag "")"
    )

    # Qwen OAuth credentials (opt-in via --with-credentials, read-write).
    # harness_ensure_config already created an empty file when missing, so it
    # always exists here (force_mount) and no "file missing" branch is needed.
    # no_status: harness_log_status prints the "Credentials:" line itself, in
    # its original position (before the GitHub summary block).
    add_optional_mount WITH_CREDENTIALS "${QWEN_CONFIG_DIR}/oauth_creds.json" "/home/coder/.qwen/oauth_creds.json" "" force_mount "Credentials" " (shared across projects)" no_status

    # Home-level env file if the user maintains one (read-only)
    if [[ -f "${QWEN_CONFIG_DIR}/.env" ]]; then
        PODMAN_ARGS+=(-v "${QWEN_CONFIG_DIR}/.env:/home/coder/.qwen/.env$(vol_flag "ro")")
    fi
}

harness_log_status() {
    log_info "Credentials: $(if $WITH_CREDENTIALS; then echo 'mounted (shared across projects)'; else echo 'not mounted (use --with-credentials)'; fi)"
}

# Load the shared engine and run. Two supported layouts:
#   - repo clone:     lib/box-common.sh next to the launcher
#   - flat install:   box-common.sh next to the launcher (e.g. ~/.local/bin)
if [[ -f "${SCRIPT_DIR}/lib/box-common.sh" ]]; then
    # shellcheck source=lib/box-common.sh
    source "${SCRIPT_DIR}/lib/box-common.sh"
elif [[ -f "${SCRIPT_DIR}/box-common.sh" ]]; then
    # shellcheck source=lib/box-common.sh
    source "${SCRIPT_DIR}/box-common.sh"
else
    echo "[ERROR] Shared engine box-common.sh not found in ${SCRIPT_DIR}" >&2
    echo "Download it next to the launcher:" >&2
    echo "  curl -fsSL https://raw.githubusercontent.com/guimou/ccbox/main/lib/box-common.sh -o ${SCRIPT_DIR}/box-common.sh" >&2
    exit 1
fi
box_main "$@"
