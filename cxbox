#!/bin/bash
# Codex CLI Development Container Launch Script
# Launches a containerized Codex CLI environment with the current directory mounted
#
# Harness-specific wrapper around lib/box-common.sh.
#
# Codex state layout (everything under CODEX_HOME, default ~/.codex):
#   ~/.codex/config.toml           global config (shared across all projects)
#   ~/.codex/auth.json             credentials (API key or ChatGPT OAuth, opt-in)
#   ~/.codex/<everything else>     per-project state: sessions/rollouts, state DB,
#                                  memories, goals, logs (keyed by project path)
#
# Because every project is mounted at /workspace inside the container, Codex's
# internal project key is identical for all projects; the per-project state dir is
# therefore isolated per project on the host (~/.codex/cxbox-projects/). The
# container's ~/.codex is a per-project dir. The shared config.toml is COPIED
# into it at launch (seeded on first run, refreshed whenever the host file is
# newer) rather than bind-mounted: Codex persists config edits (project trust,
# /model, ...) by writing a temp file and renaming it over config.toml, and a
# rename onto a single-file bind mount fails with EBUSY. Edits made inside the
# container therefore stay per-project; the host file is the source of truth.
# auth.json (credentials) is only shared when launched with --with-credentials
# (opt-in), mirroring the other launchers; Codex rewrites it in place, so a file
# mount works for it.

set -e

# Resolve the real script location (follows symlinks, e.g. ~/.local/bin/cxbox)
WRAPPER_SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$WRAPPER_SOURCE" ]]; do
    WRAPPER_DIR="$(cd -P "$(dirname "$WRAPPER_SOURCE")" && pwd)"
    WRAPPER_SOURCE="$(readlink "$WRAPPER_SOURCE")"
    [[ "$WRAPPER_SOURCE" != /* ]] && WRAPPER_SOURCE="${WRAPPER_DIR}/${WRAPPER_SOURCE}"
done
SCRIPT_DIR="$(cd -P "$(dirname "$WRAPPER_SOURCE")" && pwd)"
WRAPPER_PATH="${SCRIPT_DIR}/$(basename "$WRAPPER_SOURCE")"

# Harness identity
BOX_NAME="cxbox"
HARNESS="codex"
HARNESS_TITLE="Codex CLI"
HARNESS_CLI="codex"
REGISTRY_IMAGE="guimou/cxbox"
VERSION_FLAG="--codex-version"
VERSION_FILE="CODEX_VERSION"

# Harness-specific flags
WITH_CREDENTIALS=false

# Env vars forwarded from the host (Codex config + common provider keys).
# CODEX_HOME is deliberately NOT forwarded: inside the container Codex must use
# /home/coder/.codex (the mount target), whatever the host value is.
ENV_PASSTHROUGH_REGEX='^(CODEX_|OPENAI_|OPENROUTER_|ANTHROPIC_|GEMINI_|GOOGLE_|AZURE_|DEEPSEEK_|MISTRAL_|XAI_|GROQ_)'
ENV_PASSTHROUGH_VARS=(
    AWS_REGION AWS_PROFILE AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
    AWS_SESSION_TOKEN AWS_BEARER_TOKEN_BEDROCK
    NODE_OPTIONS NO_COLOR FORCE_COLOR
)

harness_parse_arg() {
    case $1 in
        --with-credentials)
            WITH_CREDENTIALS=true
            ARG_SHIFT=1
            ;;
        *)
            return 1
            ;;
    esac
}

harness_extra_help() {
    echo "  --with-credentials       Mount ~/.codex/auth.json read-write (API key or ChatGPT OAuth)"
}

# Ensure global config files and directories exist
harness_ensure_config() {
    CODEX_CONFIG_DIR="${HOME}/.codex"

    mkdir -p "$CODEX_CONFIG_DIR"

    # Global config (empty file is valid TOML)
    [[ -f "${CODEX_CONFIG_DIR}/config.toml" ]] || echo '' > "${CODEX_CONFIG_DIR}/config.toml"
    # Credentials store, shared across all projects (written by `codex login`
    # or the API-key flow). Opt-in via --with-credentials; without the flag the
    # container's ~/.codex is the per-project data dir, so any `codex login`
    # done inside stays per-project and never reaches this host file.
    if $WITH_CREDENTIALS; then
        if [[ ! -f "${CODEX_CONFIG_DIR}/auth.json" ]]; then
            log_info "No existing credentials found, starting fresh: ${CODEX_CONFIG_DIR}/auth.json"
            echo '{}' > "${CODEX_CONFIG_DIR}/auth.json"
        fi
    fi
}

# Setup project-specific data dir under ~/.codex/cxbox-projects/
harness_setup_project() {
    PROJECT_DATA_DIR="${HOME}/.codex/cxbox-projects/${PROJECT_KEY}"
    mkdir -p "${PROJECT_DATA_DIR}/data"

    # Seed / refresh the per-project config.toml from the shared one (see the
    # header comment for why it is copied instead of mounted)
    local shared_config="${CODEX_CONFIG_DIR}/config.toml"
    local project_config="${PROJECT_DATA_DIR}/data/config.toml"

    # Earlier cxbox versions bind-mounted config.toml as a file; podman left a
    # mount-point placeholder at this path owned by the container's root
    # (a subuid on the host), unreadable by coder. Replace anything we do not
    # own (podman unshare gives us the subuid mapping needed to delete it).
    if [[ -e "$project_config" && ! -O "$project_config" ]]; then
        log_warn "Replacing ${project_config} (not owned by you; leftover bind-mount placeholder)"
        podman unshare rm -f "$project_config" 2>/dev/null || rm -f "$project_config"
    fi

    if [[ ! -f "$project_config" ]]; then
        cp "$shared_config" "$project_config"
    elif [[ "$shared_config" -nt "$project_config" ]]; then
        log_info "Shared config.toml is newer, refreshing the per-project copy (in-container edits are replaced)"
        cp "$shared_config" "$project_config"
    fi
    # Codex must be able to read and rewrite it whatever the host file's mode
    chmod u+rw "$project_config"
}

harness_mounts() {
    PODMAN_ARGS+=(
        # Per-project state dir mounted as the container's entire Codex home
        # (sessions, state DB, memories, goals, logs, and the config.toml copy)
        -v "${PROJECT_DATA_DIR}/data:/home/coder/.codex$(vol_flag "")"
    )

    # Credentials (opt-in via --with-credentials, read-write).
    # Mounted over the per-project data dir so credentials stay shared.
    # harness_ensure_config already created an empty file when missing, so it
    # always exists here (force_mount) and no "file missing" branch is needed.
    # no_status: harness_log_status prints the "Credentials:" line itself, in
    # its original position (before the GitHub summary block).
    add_optional_mount WITH_CREDENTIALS "${CODEX_CONFIG_DIR}/auth.json" "/home/coder/.codex/auth.json" "" force_mount "Credentials" " (shared across projects)" no_status
}

harness_pre_run() {
    # The container is already the sandbox: Codex's own Linux sandbox (bundled
    # bubblewrap, or Landlock in legacy mode) cannot nest inside a rootless
    # Podman container, so disable it. Also skip the startup update check
    # (the image pins the version). Codex has no system-level config file and
    # config.toml is a per-project copy of the host file, so pass -c overrides.
    EXTRA_ARGS=(-c 'sandbox_mode="danger-full-access"' -c 'check_for_update_on_startup=false' "${EXTRA_ARGS[@]}")
    # Rebuild the shell form (used with --with-firewall), quoting each arg so
    # the TOML string quotes survive `bash -c`.
    LAUNCH_CMD="${HARNESS_CLI}$(printf ' %q' "${EXTRA_ARGS[@]}")"
}

harness_log_status() {
    log_info "Credentials: $(if $WITH_CREDENTIALS; then echo 'mounted (shared across projects)'; else echo 'not mounted (use --with-credentials)'; fi)"
}

# Load the shared engine and run. Two supported layouts:
#   - repo clone:     lib/box-common.sh next to the launcher
#   - flat install:   box-common.sh next to the launcher (e.g. ~/.local/bin)
if [[ -f "${SCRIPT_DIR}/lib/box-common.sh" ]]; then
    # shellcheck source=lib/box-common.sh
    source "${SCRIPT_DIR}/lib/box-common.sh"
elif [[ -f "${SCRIPT_DIR}/box-common.sh" ]]; then
    # shellcheck source=lib/box-common.sh
    source "${SCRIPT_DIR}/box-common.sh"
else
    echo "[ERROR] Shared engine box-common.sh not found in ${SCRIPT_DIR}" >&2
    echo "Download it next to the launcher:" >&2
    echo "  curl -fsSL https://raw.githubusercontent.com/guimou/ccbox/main/lib/box-common.sh -o ${SCRIPT_DIR}/box-common.sh" >&2
    exit 1
fi
box_main "$@"
