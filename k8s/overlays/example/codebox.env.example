# Environment variables injected into the pod and forwarded into sessions by
# the launchers (each launcher forwards the prefixes it knows: ANTHROPIC_*,
# OPENAI_*, ..., plus GH_TOKEN / GITHUB_TOKEN). Copy to codebox.env and fill
# in what you use. Leave the file empty to run without.
#
# GitHub: a fine-grained PAT or OAuth token (gh in the pod and the harness
# both use it)
GH_TOKEN=
# Anthropic (ccbox), or use Vertex AI / Bedrock variables instead
ANTHROPIC_API_KEY=
# OpenAI (cxbox, ocbox, qcbox)
OPENAI_API_KEY=
